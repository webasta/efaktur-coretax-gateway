<!DOCTYPE html>
<html lang="id">
<head><%- include('partials/head', { title: 'Completed' }) %></head>
<body class="bg-slate-50 text-slate-800 antialiased">
<%- include('partials/sidebar') %>

<div class="lg:pl-60">
<main class="max-w-6xl mx-auto px-4 sm:px-8 py-8 pt-16 lg:pt-8 space-y-6">
    <header>
        <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Completed</h1>
        <p class="text-sm text-slate-500 mt-1">Faktur Pajak lengkap (nomor + PDF) dan tercatat di invoice Zoho Books.</p>
    </header>

    <section class="bg-white rounded-xl ring-1 ring-slate-200 overflow-hidden">
        <div class="px-4 py-3 border-b border-slate-100 flex items-center justify-between gap-3">
            <span class="text-sm font-semibold text-slate-900"><%= rows.length %> invoice</span>
            <input id="tblSearch" oninput="filterTable('tbl')" type="search" placeholder="Cari invoice / customer / no. faktur"
                class="w-64 rounded-lg border border-slate-200 px-3 py-1.5 text-xs focus:outline-none focus:ring-2 focus:ring-indigo-500/30">
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="<%= ui.th %>">Date</th>
                        <th class="<%= ui.th %>">No Invoice</th>
                        <th class="<%= ui.th %>">Customer</th>
                        <th class="<%= ui.th %> text-right">Amount</th>
                        <th class="<%= ui.th %> text-right">PPN</th>
                        <th class="<%= ui.th %>">Status</th>
                        <th class="<%= ui.th %>">No Faktur</th>
                        <th class="<%= ui.th %> text-right">Action</th>
                    </tr>
                </thead>
                <tbody id="tbl" class="divide-y divide-slate-100">
                    <% rows.forEach(l => { const f = l.faktur || {}; const s = l.statusInfo; const z = l.zohoSync || {}; %>
                        <tr class="hover:bg-slate-50/60" data-search="<%= [l.invoiceNumber, l.customerName, f.number].join(' ').toLowerCase() %>">
                            <td class="<%= ui.td %> text-xs text-slate-500 whitespace-nowrap tabular-nums"><%= l.date %></td>
                            <td class="<%= ui.td %> whitespace-nowrap"><span class="font-mono text-xs font-semibold text-slate-900"><%= l.invoiceNumber %></span><% if (l.revision) { %> <span class="<%= ui.revChip %> ml-1" title="<%= ui.revTip(l) %>"><%= ui.revLabel(l) %></span><% } %></td>
                            <td class="<%= ui.td %> text-slate-700"><%= l.customerName %></td>
                            <td class="<%= ui.td %> text-right tabular-nums whitespace-nowrap"><%= ui.rp(l.totalAmount) %></td>
                            <td class="<%= ui.td %> text-right tabular-nums whitespace-nowrap"><%= ui.rp(l.totalVat) %></td>
                            <td class="<%= ui.td %> whitespace-nowrap">
                                <span class="<%= ui.chip %> <%= ui.statusClass[s.key] %>" title="<%= z.message || '' %>"><%= s.key === 'synced' ? '✓ ' : '' %><%= s.label %></span>
                                <% const a = l.airtable || {}; const atBad = a.state && a.state !== 'synced'; %>
                                <% if (a.state) { %>
                                    <div class="mt-1"><span class="<%= ui.chip %> <%= a.state === 'synced' ? 'bg-amber-50 text-amber-800 ring-amber-600/20' : 'bg-red-50 text-red-700 ring-red-600/20' %>" title="<%= a.message || '' %>">Airtable <%= a.state === 'synced' ? '✓' : '✕' %></span></div>
                                <% } %>
                                <% if (s.key !== 'synced' || atBad) { %>
                                    <button type="button" onclick="resync(<%= l.id %>, this)" class="mt-1 text-xs font-semibold text-indigo-600 hover:text-indigo-800" title="<%= [z.message, a.message].filter(Boolean).join(' • ') %>">↻ Sync</button>
                                <% } %>
                            </td>
                            <td class="<%= ui.td %>">
                                <div class="font-mono text-xs text-slate-800 whitespace-nowrap"><%= f.number %></div>
                                <div class="text-[11px] text-slate-400"><%= f.date || '' %><%= f.status ? ' · ' + f.status : '' %></div>
                            </td>
                            <td class="<%= ui.td %>">
                                <div class="flex justify-end gap-2">
                                    <% if (l.hasXml) { %>
                                        <a href="/download-xml/<%= l.id %>" class="<%= ui.btnGhost %>">⤓ XML</a>
                                    <% } else { %>
                                        <span class="<%= ui.btnDisabled %>" title="Tidak ada XML (dibuat di luar gateway)">⤓ XML</span>
                                    <% } %>
                                    <% if (l.hasPdfFile) { %>
                                        <a href="/logs/<%= l.id %>/faktur-pdf" class="<%= ui.btnPrimary %>">⤓ FP</a>
                                    <% } else { %>
                                        <button type="button" onclick="openFakturModal(this)" data-id="<%= l.id %>" data-invoice="<%= l.invoiceNumber %>"
                                            data-number="<%= f.number || '' %>" data-date="<%= f.date || '' %>" data-status="<%= f.status || '' %>"
                                            class="<%= ui.btnGhost %>" title="PDF tidak tersimpan di gateway (ada di lampiran Zoho). Klik untuk unggah ulang.">⇪ FP</button>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                    <tr id="tblEmpty" class="<%= rows.length ? 'hidden' : '' %>">
                        <td colspan="8" class="px-4 py-14 text-center text-sm text-slate-400"><%= rows.length ? 'Tidak ada yang cocok.' : 'Belum ada Faktur Pajak yang lengkap.' %></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>
</main>
</div>

<%- include('partials/modals') %>
</body>
</html>

<!-- MODAL: UPLOAD FAKTUR PAJAK -->
<div id="fakturModal" class="hidden fixed inset-0 z-50 bg-slate-900/40 flex items-center justify-center p-4">
    <form onsubmit="submitFaktur(event)" class="bg-white rounded-2xl shadow-xl w-full max-w-md overflow-hidden">
        <div class="px-6 pt-6">
            <h3 class="text-base font-semibold text-slate-900">Upload Faktur Pajak</h3>
            <p class="text-xs text-slate-500 mt-1">Invoice <span id="modalInvoice" class="font-mono font-semibold text-slate-700"></span> — dikirim ke Zoho Books.</p>
        </div>
        <div class="px-6 py-5 space-y-4">
            <input type="hidden" id="modalLogId">
            <div>
                <label class="block text-xs font-medium text-slate-600 mb-1">Nomor Faktur Pajak</label>
                <input type="text" id="modalNumber" required inputmode="numeric" placeholder="17 digit, mis. 04002600000000123"
                    class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500">
                <p id="modalNumberHint" class="text-[11px] text-slate-400 mt-1"></p>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-medium text-slate-600 mb-1">Tanggal Faktur</label>
                    <input type="date" id="modalDate" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500">
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-600 mb-1">Status Coretax</label>
                    <select id="modalStatus" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500">
                        <option>Approved</option><option>Created</option><option>Amended</option><option>Canceled</option>
                    </select>
                </div>
            </div>
            <div>
                <label class="block text-xs font-medium text-slate-600 mb-1">PDF Faktur Pajak</label>
                <label class="flex items-center gap-3 rounded-lg border border-dashed border-slate-300 px-3 py-3 cursor-pointer hover:border-indigo-400 hover:bg-indigo-50/30">
                    <span class="text-lg">📄</span>
                    <span id="modalPdfName" class="text-sm text-slate-500 truncate">Pilih file PDF dari Coretax…</span>
                    <input type="file" id="modalPdf" accept="application/pdf" class="hidden" onchange="document.getElementById('modalPdfName').innerText = this.files[0] ? this.files[0].name : 'Pilih file PDF dari Coretax…'">
                </label>
                <p class="text-[11px] text-slate-400 mt-1">Invoice pindah ke Completed setelah nomor & PDF tersimpan.</p>
            </div>
            <div id="modalMsg" class="text-xs font-medium"></div>
        </div>
        <div class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex justify-end gap-2">
            <button type="button" onclick="closeModal('fakturModal')" class="<%= ui.btnGhost %>">Batal</button>
            <button type="submit" id="modalSubmit" class="<%= ui.btnPrimary %>">Simpan & kirim ke Zoho</button>
        </div>
    </form>
</div>

<!-- MODAL: IMPOR EXCEL CORETAX -->
<div id="importModal" class="hidden fixed inset-0 z-50 bg-slate-900/40 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-4xl overflow-hidden">
        <div class="px-6 pt-6 flex items-start justify-between gap-4">
            <div>
                <h3 class="text-base font-semibold text-slate-900">Impor dari Excel Coretax</h3>
                <p class="text-xs text-slate-500 mt-1 max-w-2xl">Unggah daftar Faktur Keluaran dari Coretax (Excel/CSV). Baris dicocokkan lewat kolom <b>Referensi</b> (= nomor invoice Zoho); nomor, tanggal, dan status faktur dikirim ke Zoho. PDF tetap diunggah per invoice.</p>
            </div>
            <button type="button" id="importClose" onclick="closeModal('importModal')" class="text-slate-400 hover:text-slate-700 text-xl leading-none">×</button>
        </div>
        <div class="px-6 py-5 space-y-4">
            <div class="flex flex-wrap items-center gap-3">
                <input type="file" id="importFile" accept=".csv,.xlsx,.txt" class="text-sm file:mr-3 file:rounded-lg file:border-0 file:bg-slate-100 file:px-3 file:py-1.5 file:text-xs file:font-semibold file:text-slate-700 hover:file:bg-slate-200">
                <button type="button" onclick="sendImport(true)" class="<%= ui.btnGhost %>">Pratinjau</button>
                <button type="button" id="applyBtn" onclick="sendImport(false)" disabled class="<%= ui.btnPrimary %> disabled:opacity-40 disabled:cursor-not-allowed">Kirim ke Zoho</button>
                <label class="inline-flex items-center text-xs text-slate-600"><input type="checkbox" id="forceImport" class="mr-1.5 rounded"> Kirim ulang yang tidak berubah</label>
            </div>
            <div id="importStatus" class="text-xs font-medium"></div>
            <div id="importPreview" class="hidden overflow-auto max-h-80 rounded-lg border border-slate-200">
                <table class="w-full text-left text-xs">
                    <thead class="bg-slate-50 text-slate-500 uppercase sticky top-0">
                        <tr><th class="px-3 py-2">Baris</th><th class="px-3 py-2">Referensi</th><th class="px-3 py-2">No. Faktur</th><th class="px-3 py-2">Tanggal</th><th class="px-3 py-2">Status</th><th class="px-3 py-2">Tindakan</th><th class="px-3 py-2">Keterangan</th></tr>
                    </thead>
                    <tbody id="importRows" class="divide-y divide-slate-100"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    const esc = (s) => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    let busy = false;

    const readFileBase64 = (file) => new Promise((resolve, reject) => {
        const r = new FileReader();
        r.onload = () => resolve(r.result);
        r.onerror = () => reject(r.error);
        r.readAsDataURL(file);
    });
    const postJson = async (url, body) => {
        const res = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body || {}) });
        return res.json().catch(() => ({ success: false, message: 'Respons server tidak valid' }));
    };
    function closeModal(id) { document.getElementById(id).classList.add('hidden'); busy = false; }

    // Pencarian di tabel: setiap <tr data-search="..."> difilter, opsional juga data-status
    function filterTable(tbodyId) {
        const q = (document.getElementById(tbodyId + 'Search') || {}).value || '';
        const st = (document.getElementById(tbodyId + 'Status') || {}).value || '';
        let shown = 0;
        document.querySelectorAll('#' + tbodyId + ' tr[data-search]').forEach(r => {
            const ok = (!q || r.dataset.search.includes(q.trim().toLowerCase())) && (!st || r.dataset.status === st);
            r.classList.toggle('hidden', !ok);
            if (ok) shown++;
        });
        const empty = document.getElementById(tbodyId + 'Empty');
        if (empty) empty.classList.toggle('hidden', shown > 0);
    }

    async function resync(id, el) {
        el.disabled = true;
        const old = el.innerHTML;
        el.innerText = '…';
        const data = await postJson(`/logs/${id}/resync`);
        if (!data.success) alert(data.message);
        el.innerHTML = old;
        location.reload();
    }

    // ---------- Upload FP ----------
    function openFakturModal(b) {
        busy = true;
        document.getElementById('modalLogId').value = b.dataset.id;
        document.getElementById('modalInvoice').innerText = b.dataset.invoice;
        document.getElementById('modalNumber').value = b.dataset.number || '';
        document.getElementById('modalDate').value = b.dataset.date || new Date().toISOString().slice(0, 10);
        document.getElementById('modalStatus').value = b.dataset.status || 'Approved';
        document.getElementById('modalPdf').value = '';
        document.getElementById('modalPdfName').innerText = 'Pilih file PDF dari Coretax…';
        document.getElementById('modalMsg').innerText = '';
        checkNumber();
        document.getElementById('fakturModal').classList.remove('hidden');
        document.getElementById('modalNumber').focus();
    }
    function checkNumber() {
        const d = document.getElementById('modalNumber').value.replace(/\D/g, '');
        const hint = document.getElementById('modalNumberHint');
        hint.className = 'text-[11px] mt-1 ' + (d && d.length !== 17 ? 'text-amber-600' : 'text-slate-400');
        hint.innerText = d ? `${d.length} digit${d.length !== 17 ? ' — NSFP Coretax umumnya 17 digit' : ''}` : '';
    }
    document.getElementById('modalNumber').addEventListener('input', checkNumber);
    async function submitFaktur(e) {
        e.preventDefault();
        const msg = document.getElementById('modalMsg');
        const btn = document.getElementById('modalSubmit');
        btn.disabled = true;
        msg.className = 'text-xs font-medium text-indigo-600';
        msg.innerText = 'Mengirim ke Zoho Books…';
        try {
            const pdf = document.getElementById('modalPdf').files[0];
            const data = await postJson(`/logs/${document.getElementById('modalLogId').value}/faktur`, {
                fakturNumber: document.getElementById('modalNumber').value.replace(/\D/g, ''),
                fakturDate: document.getElementById('modalDate').value,
                status: document.getElementById('modalStatus').value,
                pdfBase64: pdf ? await readFileBase64(pdf) : null,
                pdfFilename: pdf ? pdf.name : null
            });
            if (data.success || data.pending) { location.reload(); return; }
            throw new Error(data.message);
        } catch (err) {
            msg.className = 'text-xs font-medium text-red-600';
            msg.innerText = err.message + ' (data tetap tersimpan; bisa dicoba lagi lewat Sinkron)';
        } finally { btn.disabled = false; }
    }

    // ---------- Impor Coretax ----------
    function openImport() { busy = true; document.getElementById('importModal').classList.remove('hidden'); }
    if (location.hash === '#impor') openImport();
    const ACTION_LABEL = {
        sync: '<span class="text-indigo-700 font-semibold">Kirim</span>',
        lookup: '<span class="text-violet-700 font-semibold">Cari di Zoho & kirim</span>',
        unchanged: '<span class="text-slate-400">Tidak berubah</span>',
        skip: '<span class="text-red-600">Lewati</span>'
    };
    function renderImportRows(records, applied) {
        document.getElementById('importPreview').classList.remove('hidden');
        document.getElementById('importRows').innerHTML = records.map(r => {
            let action = ACTION_LABEL[r.action] || esc(r.action);
            if (applied && r.action !== 'skip' && r.action !== 'unchanged') {
                action = r.ok ? '<span class="text-emerald-700 font-semibold">✓ Terkirim</span>' : '<span class="text-red-700 font-semibold">✕ Gagal</span>';
            }
            return `<tr><td class="px-3 py-1.5 text-slate-400">${esc(r.row)}</td><td class="px-3 py-1.5 font-mono">${esc(r.reference)}</td>
                <td class="px-3 py-1.5 font-mono">${esc(r.fakturNumber)}</td><td class="px-3 py-1.5">${esc(r.fakturDate)}</td>
                <td class="px-3 py-1.5">${esc(r.status)}</td><td class="px-3 py-1.5">${action}</td>
                <td class="px-3 py-1.5 text-slate-500">${esc(applied ? (r.message || r.note) : r.note)}</td></tr>`;
        }).join('') || '<tr><td colspan="7" class="px-3 py-4 text-center text-slate-400">Tidak ada baris data</td></tr>';
    }
    async function sendImport(dryRun) {
        const file = document.getElementById('importFile').files[0];
        const status = document.getElementById('importStatus');
        if (!file) { status.className = 'text-xs font-medium text-red-600'; status.innerText = 'Pilih file dulu.'; return; }
        status.className = 'text-xs font-medium text-indigo-600';
        status.innerText = dryRun ? 'Membaca file…' : 'Mengirim ke Zoho Books…';
        try {
            const data = await postJson('/coretax/import', {
                filename: file.name, contentBase64: await readFileBase64(file),
                dryRun, force: document.getElementById('forceImport').checked
            });
            if (!data.success) throw new Error(data.message);
            renderImportRows(data.records, !dryRun);
            if (dryRun) {
                const n = data.records.filter(r => r.action === 'sync' || r.action === 'lookup').length;
                status.className = 'text-xs font-medium text-slate-700';
                status.innerText = `${data.records.length} baris terbaca, ${n} siap dikirim.`;
                document.getElementById('applyBtn').disabled = n === 0 && !document.getElementById('forceImport').checked;
            } else {
                const s = data.summary;
                status.className = 'text-xs font-medium ' + (s.failed ? 'text-amber-700' : 'text-emerald-700');
                status.innerText = `Selesai: ${s.synced} terkirim, ${s.unchanged} tidak berubah, ${s.failed} gagal, ${s.skipped} dilewati.`;
                document.getElementById('applyBtn').disabled = true;
                document.getElementById('importClose').onclick = () => { history.replaceState(null, '', location.pathname); location.reload(); };
            }
        } catch (e) {
            status.className = 'text-xs font-medium text-red-600';
            status.innerText = e.message;
        }
    }

    // ---------- Auto refresh (jeda saat modal terbuka / tab tidak aktif) ----------
    (function () {
        let lastVersion = null, lastCount = null;
        setInterval(() => {
            if (busy || document.hidden) return;
            fetch('/api/logs/count').then(r => r.json()).then(d => {
                if (lastVersion === null) { lastVersion = d.version; lastCount = d.count; return; }
                if (d.count !== lastCount || d.version !== lastVersion) location.reload();
            }).catch(() => {});
        }, 5000);
    })();
</script>

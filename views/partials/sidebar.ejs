<%
    // Variabel: active ('dashboard' | 'settings'), username, companyName, counts (opsional: {baru, upload, lengkap, gagal})
    const c = (typeof counts !== 'undefined' && counts) ? counts : {};
    const onDash = active === 'dashboard';
    const navLink = (hash) => onDash ? '#' + hash : '/dashboard#' + hash;
    const itemCls = "nav-item group flex items-center justify-between rounded-lg px-3 py-2 text-sm font-medium text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition";
%>
<!-- Tombol menu (mobile) -->
<button type="button" onclick="document.getElementById('sidebar').classList.toggle('-translate-x-full')"
    class="lg:hidden fixed top-3 left-3 z-40 bg-white border border-slate-200 rounded-lg px-3 py-2 text-sm shadow-sm">☰ Menu</button>

<aside id="sidebar" class="fixed inset-y-0 left-0 z-30 w-64 bg-white border-r border-slate-200 flex flex-col transform -translate-x-full lg:translate-x-0 transition-transform">
    <div class="px-5 py-5 border-b border-slate-100">
        <div class="flex items-center gap-2.5">
            <div class="h-9 w-9 rounded-lg bg-indigo-600 text-white flex items-center justify-center font-bold">eF</div>
            <div class="min-w-0">
                <div class="text-sm font-bold text-slate-900 leading-tight">e-Faktur Gateway</div>
                <div class="text-xs text-slate-500 truncate"><%= companyName || 'Zoho Books ⇄ Coretax' %></div>
            </div>
        </div>
    </div>

    <nav class="flex-1 overflow-y-auto px-3 py-4 space-y-6">
        <div>
            <div class="px-3 mb-2 text-[11px] font-semibold uppercase tracking-wider text-slate-400">Alur Faktur</div>
            <a href="<%= navLink('baru') %>" data-tab="baru" class="<%= itemCls %>">
                <span class="flex items-center gap-2.5"><span class="h-2 w-2 rounded-full bg-sky-500"></span>Baru Rilis</span>
                <% if (c.baru !== undefined) { %><span class="rounded-full bg-sky-50 text-sky-700 text-xs font-semibold px-2 py-0.5"><%= c.baru %></span><% } %>
            </a>
            <a href="<%= navLink('upload') %>" data-tab="upload" class="<%= itemCls %>">
                <span class="flex items-center gap-2.5"><span class="h-2 w-2 rounded-full bg-amber-500"></span>Perlu Upload Faktur</span>
                <% if (c.upload !== undefined) { %><span class="rounded-full bg-amber-50 text-amber-700 text-xs font-semibold px-2 py-0.5"><%= c.upload %></span><% } %>
            </a>
            <a href="<%= navLink('lengkap') %>" data-tab="lengkap" class="<%= itemCls %>">
                <span class="flex items-center gap-2.5"><span class="h-2 w-2 rounded-full bg-emerald-500"></span>Sudah Lengkap</span>
                <% if (c.lengkap !== undefined) { %><span class="rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold px-2 py-0.5"><%= c.lengkap %></span><% } %>
            </a>
            <a href="<%= onDash ? '#riwayat' : '/dashboard#riwayat' %>" data-scroll="riwayat" class="<%= itemCls %>">
                <span class="flex items-center gap-2.5"><span class="text-slate-400">🕘</span>Riwayat</span>
                <% if (c.gagal) { %><span class="rounded-full bg-red-50 text-red-700 text-xs font-semibold px-2 py-0.5"><%= c.gagal %> gagal</span><% } %>
            </a>
        </div>

        <div>
            <div class="px-3 mb-2 text-[11px] font-semibold uppercase tracking-wider text-slate-400">Alat</div>
            <a href="<%= onDash ? '#impor' : '/dashboard#impor' %>" data-open="impor" class="<%= itemCls %>">
                <span class="flex items-center gap-2.5"><span class="text-slate-400">⇪</span>Impor dari Coretax</span>
            </a>
        </div>

        <div>
            <div class="px-3 mb-2 text-[11px] font-semibold uppercase tracking-wider text-slate-400">Akun</div>
            <a href="/settings" class="<%= itemCls %> <%= active === 'settings' ? 'bg-indigo-50 text-indigo-700' : '' %>">
                <span class="flex items-center gap-2.5"><span class="text-slate-400">⚙</span>Pengaturan</span>
            </a>
            <% if (username === 'admin') { %>
                <a href="/superadmin" class="<%= itemCls %>">
                    <span class="flex items-center gap-2.5"><span class="text-slate-400">♛</span>Superadmin</span>
                </a>
            <% } %>
        </div>
    </nav>

    <div class="border-t border-slate-100 px-4 py-4 flex items-center justify-between">
        <div class="flex items-center gap-2.5 min-w-0">
            <div class="h-8 w-8 rounded-full bg-slate-100 text-slate-600 flex items-center justify-center text-xs font-bold uppercase"><%= String(username || '?').slice(0, 2) %></div>
            <div class="text-sm font-medium text-slate-700 truncate"><%= username %></div>
        </div>
        <a href="/logout" class="text-xs font-semibold text-slate-500 hover:text-red-600">Keluar</a>
    </div>
</aside>

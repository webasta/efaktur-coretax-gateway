<!DOCTYPE html>
<html lang="id">
<head><%- include('partials/head', { title: 'Pending' }) %></head>
<body class="bg-slate-50 text-slate-800 antialiased">
<%- include('partials/sidebar') %>

<div class="lg:pl-60">
<main class="max-w-6xl mx-auto px-4 sm:px-8 py-8 pt-16 lg:pt-8 space-y-6">
    <header class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Pending</h1>
            <p class="text-sm text-slate-500 mt-1">XML sudah terbit. Unggah ke Coretax, lalu upload Faktur Pajak (nomor + PDF) di sini.</p>
        </div>
        <button type="button" onclick="openImport()" class="<%= ui.btnGhost %>">⇪ Impor dari Excel Coretax</button>
    </header>

    <% const revCount = rows.filter(r => r.revision).length; if (revCount) { %>
        <div class="rounded-xl bg-violet-50 ring-1 ring-violet-100 px-4 py-3 text-sm text-violet-800">
            <b><%= revCount %> invoice direvisi</b> di Zoho Books (bertanda <span class="<%= ui.revChip %>">Revisi</span>). Jika XML versi sebelumnya sudah diunggah ke Coretax, hapus draft lama di Coretax sebelum mengunggah XML revisi.
        </div>
    <% } %>

    <section class="bg-white rounded-xl ring-1 ring-slate-200 overflow-hidden">
        <div class="px-4 py-3 border-b border-slate-100 flex items-center justify-between gap-3">
            <span class="text-sm font-semibold text-slate-900"><%= rows.length %> invoice</span>
            <input id="tblSearch" oninput="filterTable('tbl')" type="search" placeholder="Cari invoice / customer"
                class="w-64 rounded-lg border border-slate-200 px-3 py-1.5 text-xs focus:outline-none focus:ring-2 focus:ring-indigo-500/30">
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="<%= ui.th %>">Date</th>
                        <th class="<%= ui.th %>">No Invoice</th>
                        <th class="<%= ui.th %>">Customer</th>
                        <th class="<%= ui.th %> text-right">Amount</th>
                        <th class="<%= ui.th %> text-right">PPN</th>
                        <th class="<%= ui.th %>">Status</th>
                        <th class="<%= ui.th %> text-right">Action</th>
                    </tr>
                </thead>
                <tbody id="tbl" class="divide-y divide-slate-100">
                    <% rows.forEach(l => { const f = l.faktur || {}; const s = l.statusInfo; const z = l.zohoSync || {}; %>
                        <tr class="hover:bg-slate-50/60" data-search="<%= [l.invoiceNumber, l.customerName].join(' ').toLowerCase() %>">
                            <td class="<%= ui.td %> text-xs text-slate-500 whitespace-nowrap tabular-nums"><%= l.date %></td>
                            <td class="<%= ui.td %> whitespace-nowrap"><span class="font-mono text-xs font-semibold text-slate-900"><%= l.invoiceNumber %></span><% if (l.revision) { %> <span class="<%= ui.revChip %> ml-1" title="Invoice direvisi di Zoho Books. Jika XML versi sebelumnya sudah diunggah ke Coretax, hapus draft lama di Coretax sebelum mengunggah XML revisi ini.">Revisi <%= l.revision %></span><% } %></td>
                            <td class="<%= ui.td %> text-slate-700"><%= l.customerName %></td>
                            <td class="<%= ui.td %> text-right tabular-nums whitespace-nowrap"><%= ui.rp(l.totalAmount) %></td>
                            <td class="<%= ui.td %> text-right tabular-nums whitespace-nowrap"><%= ui.rp(l.totalVat) %></td>
                            <td class="<%= ui.td %>">
                                <span class="<%= ui.chip %> <%= ui.statusClass[s.key] %>" title="<%= z.message || '' %>"><%= s.label %></span>
                                <% if (f.number) { %><div class="mt-1 font-mono text-[11px] text-slate-500"><%= f.number %></div><% } %>
                            </td>
                            <td class="<%= ui.td %>">
                                <div class="flex justify-end gap-2">
                                    <% if (l.hasXml) { %>
                                        <a href="/download-xml/<%= l.id %>" class="<%= ui.btnGhost %>">⤓ XML</a>
                                    <% } else { %>
                                        <span class="<%= ui.btnDisabled %>" title="Tidak ada XML (dibuat di luar gateway)">⤓ XML</span>
                                    <% } %>
                                    <% if (s.key === 'sync_failed') { %>
                                        <button type="button" onclick="resync(<%= l.id %>, this)" class="<%= ui.btnGhost %>" title="<%= z.message || '' %>">↻</button>
                                    <% } %>
                                    <button type="button" onclick="openFakturModal(this)" data-id="<%= l.id %>" data-invoice="<%= l.invoiceNumber %>"
                                        data-number="<%= f.number || '' %>" data-date="<%= f.date || '' %>" data-status="<%= f.status || '' %>"
                                        class="<%= ui.btnPrimary %>">⇪ Upload FP</button>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                    <tr id="tblEmpty" class="<%= rows.length ? 'hidden' : '' %>">
                        <td colspan="7" class="px-4 py-14 text-center text-sm text-slate-400"><%= rows.length ? 'Tidak ada yang cocok.' : 'Tidak ada yang pending. Invoice muncul di sini otomatis setelah berstatus Sent di Zoho Books.' %></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>
</main>
</div>

<%- include('partials/modals') %>
</body>
</html>

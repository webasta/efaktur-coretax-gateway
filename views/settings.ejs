<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Pengaturan - eFaktur System</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 font-sans">
    
    <!-- Navbar Utama -->
    <nav class="bg-white shadow-sm border-b border-gray-200 px-6 py-4 flex justify-between items-center">
        <div class="flex items-center space-x-3">
            <span class="text-2xl">⚙️</span>
            <h1 class="text-xl font-bold text-gray-800">e-Faktur SaaS Gateway Settings</h1>
        </div>
        <div class="flex items-center space-x-4">
            <a href="/dashboard" class="text-sm font-semibold text-blue-600 hover:text-blue-800 transition">📊 Dashboard</a>
            <span class="text-gray-300">|</span>
            <span class="text-sm text-gray-600">Perusahaan: <strong><%= user.companyName || 'Belum Diatur' %></strong></span>
            <a href="/logout" class="bg-red-500 hover:bg-red-600 text-white text-xs font-semibold px-3 py-1.5 rounded-lg transition duration-200">Logout</a>
        </div>
    </nav>

    <!-- Konten Utama -->
    <main class="max-w-4xl mx-auto p-6 space-y-6">

        <!-- Notifikasi Sukses -->
        <% if (success) { %>
            <div class="bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-xl text-sm font-medium">
                🌱 <%= success %>
            </div>
        <% } %>
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-xl text-sm font-medium">
                ⚠️ <%= error %>
            </div>
        <% } %>

        <!-- KARTU 1: API KEY & INTEGRASI (Kunci Masuk Zoho) -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            <div class="px-6 py-4 bg-gray-50 border-b border-gray-200">
                <h3 class="font-semibold text-gray-700">🔑 Kredensial Integrasi Zoho Books</h3>
                <p class="text-xs text-gray-500 mt-0.5">Gunakan informasi di bawah ini untuk menghubungkan otomatisasi Webhook di Zoho Books.</p>
            </div>
            <div class="p-6 space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-gray-600 uppercase tracking-wider mb-2">API Key Anda</label>
                    <div class="flex space-x-2">
                        <input type="password" id="apiKeyInput" value="<%= user.apiKey %>" readonly class="bg-gray-100 border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono text-gray-600 flex-1 focus:outline-none">
                        <button type="button" onclick="toggleApiKey()" class="bg-gray-200 hover:bg-gray-300 text-gray-700 px-3 py-2 rounded-lg text-xs font-semibold transition">Lihat/Sembunyikan</button>
                        <form action="/settings/regenerate-key" method="POST" onsubmit="return confirm('Apakah Anda yakin ingin memperbarui API Key? Webhook lama di Zoho akan berhenti berfungsi sampai Anda memperbaruinya.');">
                            <button type="submit" class="bg-amber-500 hover:bg-amber-600 text-white px-3 py-2 rounded-lg text-xs font-semibold transition">Ganti Key Baru</button>
                        </form>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-600 uppercase tracking-wider mb-2">Webhook URL Terarah (Salin ke Zoho Books)</label>
                    <div class="flex space-x-2">
                        <input type="text" id="webhookUrlInput" value="<%= publicBaseUrl %>/zoho-to-coretax?api_key=<%= user.apiKey %>" readonly class="bg-blue-50/50 border border-blue-200 text-blue-700 rounded-lg px-3 py-2 text-sm font-mono flex-1 focus:outline-none">
                        <button type="button" onclick="copyWebhookUrl()" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-xs font-semibold transition">Salin URL</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- KARTU 2: CONFIG PEMBUATAN XML & SMTP EMAIL -->
        <form action="/settings/save" method="POST" class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            <div class="px-6 py-4 bg-gray-50 border-b border-gray-200">
                <h3 class="font-semibold text-gray-700">📋 Konfigurasi e-Faktur & Pengiriman</h3>
                <p class="text-xs text-gray-500 mt-0.5">Data di bawah ini akan digunakan untuk menyusun profil XML pajak dan mengirim email otomatis.</p>
            </div>
            
            <div class="p-6 space-y-6 divide-y divide-gray-100">
                
                <!-- Grup Identitas Pajak -->
                <div class="space-y-4">
                    <h4 class="text-sm font-bold text-gray-800">1. Data Profil Wajib Pajak (DJP CoreTax)</h4>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1">Nama Perusahaan / Klien</label>
                            <input type="text" name="companyName" value="<%= user.companyName %>" required class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-blue-500 focus:outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1">NPWP Penjual (16 Digit TIN)</label>
                            <input type="text" name="sellerTin" value="<%= user.config.sellerTin %>" placeholder="Contoh: 0800195299077000" required class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono focus:border-blue-500 focus:outline-none">
                        </div>
                        <div class="md:col-span-2">
                            <label class="block text-xs font-semibold text-gray-600 mb-1">ID TKU Penjual (SellerIDTKU - 22 Digit)</label>
                            <input type="text" name="sellerTku" value="<%= user.config.sellerTku %>" placeholder="Contoh: 0800195299077000000000" required class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono focus:border-blue-500 focus:outline-none">
                        </div>
                    </div>
                </div>

                <!-- Grup Pengaturan Server SMTP Klien -->
                <div class="space-y-4 pt-6">
                    <div class="flex items-center justify-between">
                        <h4 class="text-sm font-bold text-gray-800">2. Konfigurasi Server Kirim Surat (SMTP Outbound)</h4>
                        
                        <!-- Toggle / Sakelar Pilihan SMTP -->
                        <label class="inline-flex items-center cursor-pointer bg-blue-50 px-3 py-1.5 rounded-lg border border-blue-200">
                            <input type="checkbox" name="useCustomSmtp" value="true" id="smtpToggle" onchange="toggleSmtpForm()" <%= user.config.useCustomSmtp ? 'checked' : '' %> class="rounded border-gray-300 text-blue-600 focus:ring-blue-500 h-4 w-4">
                            <span class="ml-2 text-xs font-semibold text-blue-800">Gunakan Server SMTP Kustom Perusahaan</span>
                        </label>
                    </div>

                    <!-- Area Form SMTP yang akan muncul/hilang secara dinamis -->
                    <div id="smtpFormSection" class="grid grid-cols-1 md:grid-cols-3 gap-4 transition duration-300">
                        <div class="md:col-span-2">
                            <label class="block text-xs font-semibold text-gray-600 mb-1">SMTP Host / Server</label>
                            <input type="text" name="smtpHost" id="smtpHost" value="<%= user.config.smtpHost %>" placeholder="mail.perusahaan.com" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-blue-500 focus:outline-none disabled:bg-gray-100 disabled:text-gray-400">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1">SMTP Port</label>
                            <input type="number" name="smtpPort" id="smtpPort" value="<%= user.config.smtpPort || 465 %>" placeholder="465" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-blue-500 focus:outline-none disabled:bg-gray-100 disabled:text-gray-400">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1">Username / Email SMTP</label>
                            <input type="email" name="smtpUser" id="smtpUser" value="<%= user.config.smtpUser %>" placeholder="finance@perusahaan.com" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-blue-500 focus:outline-none disabled:bg-gray-100 disabled:text-gray-400">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1">Password SMTP</label>
                            <input type="password" name="smtpPass" id="smtpPass" placeholder="••••••••" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-blue-500 focus:outline-none disabled:bg-gray-100 disabled:text-gray-400">
                        </div>
                    </div>

                    <!-- TOMBOL TES SMTP (Disisipkan di sini) -->
                    <div id="testSmtpBtnContainer" class="pt-2 hidden">
                        <button type="button" onclick="testSmtpConnection()" class="bg-purple-600 hover:bg-purple-700 text-white text-xs font-bold px-4 py-2 rounded-lg shadow-sm transition duration-200">
                            ⚡ Jalankan Tes SMTP Kustom
                        </button>
                        <span id="testSmtpStatus" class="ml-3 text-xs font-semibold"></span>
                    </div>

                    <!-- Input Email Target Penerima (Selalu Terbuka & Wajib Diisi) -->
                    <div class="pt-2">
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Email Target Finansial (Tujuan Pengiriman Lampiran XML)</label>
                        <input type="email" name="emailTarget" value="<%= user.config.emailTarget %>" placeholder="accounting@perusahaan.com" required class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-blue-500 focus:outline-none">
                    </div>
                </div>

            </div>

            <!-- Tombol Aksi Simpan -->
            <div class="px-6 py-4 bg-gray-50 border-t border-gray-100 flex justify-end">
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-bold px-6 py-2 rounded-lg shadow-sm transition duration-200">
                    💾 Simpan Konfigurasi
                </button>
            </div>
        </form>

        <!-- KARTU 3: KONEKSI BALIK KE ZOHO BOOKS (Coretax -> Zoho) -->
        <form id="zoho" action="/settings/zoho" method="POST" class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            <div class="px-6 py-4 bg-gray-50 border-b border-gray-200 flex items-center justify-between">
                <div>
                    <h3 class="font-semibold text-gray-700">🔁 Sinkronisasi Balik ke Zoho Books</h3>
                    <p class="text-xs text-gray-500 mt-0.5">Mengirim Nomor Faktur Pajak, tanggal, status, dan PDF dari Coretax kembali ke invoice di Zoho Books.</p>
                </div>
                <label class="inline-flex items-center cursor-pointer bg-blue-50 px-3 py-1.5 rounded-lg border border-blue-200">
                    <input type="checkbox" name="zohoEnabled" value="true" <%= user.zoho.enabled ? 'checked' : '' %> class="h-4 w-4">
                    <span class="ml-2 text-xs font-semibold text-blue-800">Aktifkan</span>
                </label>
            </div>

            <div class="p-6 space-y-6 divide-y divide-gray-100">
                <%
                    const z = user.zoho;
                    const oauthConnected = z.authMode === 'oauth' && z.hasRefreshToken;
                    const selfActive = z.authMode === 'self' && z.hasRefreshToken;
                    const inputCls = "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono focus:border-blue-500 focus:outline-none";
                %>
                <div class="space-y-4">
                    <h4 class="text-sm font-bold text-gray-800">1. Koneksi Akun Zoho Books</h4>

                    <% if (oauthAvailable) { %>
                        <% if (oauthConnected) { %>
                            <div class="bg-green-50 border border-green-200 rounded-xl p-4 space-y-3">
                                <div class="flex items-start justify-between gap-4">
                                    <div>
                                        <div class="text-sm font-semibold text-green-800">✅ Terhubung ke Zoho Books</div>
                                        <div class="text-xs text-green-700 mt-0.5">Data center zoho.<%= z.dataCenter %> · sejak <%= z.connectedAt || '-' %></div>
                                    </div>
                                    <div class="flex gap-2 shrink-0">
                                        <a href="/zoho/connect" class="border border-green-300 bg-white hover:bg-green-100 text-green-800 text-xs font-semibold px-3 py-1.5 rounded-lg">🔄 Hubungkan Ulang</a>
                                        <button type="submit" formaction="/zoho/disconnect" formmethod="post" onclick="return confirm('Putuskan koneksi Zoho Books?')" class="border border-red-200 bg-white hover:bg-red-50 text-red-700 text-xs font-semibold px-3 py-1.5 rounded-lg">Putuskan</button>
                                    </div>
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-gray-600 mb-1">Organisasi Zoho Books</label>
                                    <select name="organizationId" class="<%= inputCls %> bg-white">
                                        <% (z.organizations || []).forEach(o => { %>
                                            <option value="<%= o.id %>" <%= z.organizationId === o.id ? 'selected' : '' %>><%= o.name %> (<%= o.id %>)</option>
                                        <% }) %>
                                    </select>
                                </div>
                            </div>
                        <% } else { %>
                            <div class="border-2 border-dashed border-blue-200 rounded-xl p-6 text-center space-y-3">
                                <p class="text-sm text-gray-600">Klik tombol di bawah, login ke Zoho, lalu pilih <strong>Accept</strong>. Organisasi Zoho Books akan terdeteksi otomatis.</p>
                                <a href="/zoho/connect" class="inline-flex items-center bg-blue-600 hover:bg-blue-700 text-white text-sm font-bold px-6 py-2.5 rounded-lg shadow-sm transition">🔗 Hubungkan ke Zoho Books</a>
                                <% if (selfActive) { %><p class="text-xs text-amber-700">Saat ini memakai Self Client manual. Menghubungkan via tombol akan menggantikannya.</p><% } %>
                            </div>
                        <% } %>
                    <% } %>

                    <details class="group" <%= (!oauthAvailable || selfActive) ? 'open' : '' %>>
                        <% if (oauthAvailable) { %>
                            <summary class="cursor-pointer text-xs font-semibold text-gray-500 hover:text-gray-700">⚙️ Mode lanjutan: Self Client manual</summary>
                        <% } %>
                        <div class="mt-3 space-y-4">
                            <% if (oauthAvailable) { %>
                                <label class="inline-flex items-center text-sm text-gray-700"><input type="checkbox" name="useSelfClient" value="true" <%= selfActive ? 'checked' : '' %> class="mr-2"> Gunakan Self Client manual (bukan tombol Hubungkan)</label>
                            <% } else { %>
                                <input type="hidden" name="useSelfClient" value="true">
                            <% } %>
                            <p class="text-xs text-gray-500 leading-relaxed">
                                Buat di <span class="font-mono">api-console.zoho.com</span> → <em>Self Client</em> → tab <em>Generate Code</em> dengan scope
                                <code class="bg-gray-100 px-1 rounded">ZohoBooks.invoices.ALL,ZohoBooks.settings.READ</code>,
                                lalu tukar kode tersebut menjadi <em>refresh token</em> (lihat README).
                            </p>
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                <div>
                                    <label class="block text-xs font-semibold text-gray-600 mb-1">Data Center</label>
                                    <select name="dataCenter" class="<%= inputCls %>">
                                        <% dataCenters.forEach(dc => { %>
                                            <option value="<%= dc %>" <%= z.dataCenter === dc ? 'selected' : '' %>>zoho.<%= dc %></option>
                                        <% }) %>
                                    </select>
                                </div>
                                <div class="md:col-span-2">
                                    <label class="block text-xs font-semibold text-gray-600 mb-1">Organization ID</label>
                                    <input type="text" name="selfOrganizationId" value="<%= z.authMode === 'self' ? z.organizationId : '' %>" placeholder="Zoho Books → Settings → Organization Profile" class="<%= inputCls %>">
                                </div>
                                <div class="md:col-span-3">
                                    <label class="block text-xs font-semibold text-gray-600 mb-1">Client ID</label>
                                    <input type="text" name="clientId" value="<%= z.clientId %>" class="<%= inputCls %>">
                                </div>
                                <div class="md:col-span-3">
                                    <label class="block text-xs font-semibold text-gray-600 mb-1">Client Secret <%= (z.authMode === 'self' && z.hasClientSecret) ? '(tersimpan — kosongkan jika tidak diganti)' : '' %></label>
                                    <input type="password" name="clientSecret" placeholder="<%= (z.authMode === 'self' && z.hasClientSecret) ? '••••••••••••' : '' %>" autocomplete="new-password" class="<%= inputCls %>">
                                </div>
                                <div class="md:col-span-3">
                                    <label class="block text-xs font-semibold text-gray-600 mb-1">Refresh Token <%= selfActive ? '(tersimpan — kosongkan jika tidak diganti)' : '' %></label>
                                    <input type="password" name="refreshToken" placeholder="<%= selfActive ? '••••••••••••' : '1000.xxxx...' %>" autocomplete="new-password" class="<%= inputCls %>">
                                </div>
                            </div>
                        </div>
                    </details>
                </div>

                <div class="space-y-4 pt-6">
                    <h4 class="text-sm font-bold text-gray-800">2. Custom Field Invoice di Zoho Books (API name)</h4>
                    <p class="text-xs text-gray-500">Buat field ini di Zoho Books → Settings → Invoices → Field Customization (tipe <strong>Text</strong> untuk nomor & status, <strong>Date</strong> untuk tanggal). Kosongkan untuk tidak mengisi field tersebut.</p>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1">Nomor Faktur Pajak</label>
                            <input type="text" name="fieldFakturNumber" value="<%= user.zoho.fieldFakturNumber %>" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono focus:border-blue-500 focus:outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1">Tanggal Faktur Pajak</label>
                            <input type="text" name="fieldFakturDate" value="<%= user.zoho.fieldFakturDate %>" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono focus:border-blue-500 focus:outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1">Status e-Faktur</label>
                            <input type="text" name="fieldFakturStatus" value="<%= user.zoho.fieldFakturStatus %>" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono focus:border-blue-500 focus:outline-none">
                        </div>
                    </div>
                    <div class="flex flex-col space-y-2 text-sm text-gray-700">
                        <label class="inline-flex items-center"><input type="checkbox" name="markOnXmlGenerated" value="true" <%= user.zoho.markOnXmlGenerated ? 'checked' : '' %> class="mr-2"> Isi status <strong class="mx-1">"XML Dibuat"</strong> di Zoho segera setelah XML terkirim</label>
                        <label class="inline-flex items-center"><input type="checkbox" name="addComment" value="true" <%= user.zoho.addComment ? 'checked' : '' %> class="mr-2"> Tambahkan komentar riwayat di invoice Zoho</label>
                        <label class="inline-flex items-center"><input type="checkbox" name="attachPdf" value="true" <%= user.zoho.attachPdf ? 'checked' : '' %> class="mr-2"> Lampirkan PDF Faktur Pajak ke invoice (jika diunggah)</label>
                    </div>
                    <div class="bg-amber-50 border border-amber-200 text-amber-800 text-xs px-3 py-2 rounded-lg">
                        💡 Jika Workflow Rule webhook di Zoho dipicu saat invoice <em>diedit</em>, update dari gateway akan memicu webhook lagi.
                        Gateway sudah mengabaikan webhook untuk invoice yang isinya tidak berubah atau sudah bernomor faktur, jadi tidak terjadi email/XML ganda.
                    </div>
                </div>

                <div class="pt-6">
                    <h4 class="text-sm font-bold text-gray-800 mb-2">3. API Hasil Coretax (opsional, untuk otomasi)</h4>
                    <input type="text" readonly value="POST <%= publicBaseUrl %>/api/coretax-result  (header X-API-Key: API Key Anda)" class="w-full bg-gray-100 border border-gray-300 rounded-lg px-3 py-2 text-xs font-mono text-gray-600">
                </div>
            </div>

            <div class="px-6 py-4 bg-gray-50 border-t border-gray-100 flex items-center justify-between">
                <div>
                    <button type="button" onclick="testZoho()" class="bg-purple-600 hover:bg-purple-700 text-white text-xs font-bold px-4 py-2 rounded-lg shadow-sm transition">⚡ Tes Koneksi Zoho (setelah disimpan)</button>
                    <span id="testZohoStatus" class="ml-3 text-xs font-semibold"></span>
                </div>
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-bold px-6 py-2 rounded-lg shadow-sm transition">💾 Simpan Pengaturan Zoho</button>
            </div>
        </form>
    </main>

    <!-- Script Pembantu UI -->
    <script>
        function toggleApiKey() {
            const input = document.getElementById('apiKeyInput');
            if (input.type === "password") {
                input.type = "text";
            } else {
                input.type = "password";
            }
        }

        function copyWebhookUrl() {
            const copyText = document.getElementById('webhookUrlInput');
            copyText.select();
            copyText.setSelectionRange(0, 99999); // Untuk perangkat mobile
            navigator.clipboard.writeText(copyText.value);
            alert("URL Webhook berhasil disalin! Sila tempel pada sistem Zoho Books Anda.");
        }

        function toggleSmtpForm() {
            const isChecked = document.getElementById('smtpToggle').checked;
            const fields = ['smtpHost', 'smtpPort', 'smtpUser', 'smtpPass'];
            const formSection = document.getElementById('smtpFormSection');
            const testBtnContainer = document.getElementById('testSmtpBtnContainer');
            
            fields.forEach(id => {
                const element = document.getElementById(id);
                element.disabled = !isChecked;
                if (!isChecked) {
                    element.required = false;
                } else {
                    if(id !== 'smtpPass') element.required = true;
                }
            });

            if (!isChecked) {
                formSection.classList.add('opacity-40');
                testBtnContainer.classList.add('hidden'); // Sembunyikan tombol jika menggunakan default
            } else {
                formSection.classList.remove('opacity-40');
                testBtnContainer.classList.remove('hidden'); // Tampilkan tombol tes jika centang kustom
            }
        }

        function testSmtpConnection() {
            const statusLabel = document.getElementById('testSmtpStatus');
            statusLabel.className = "ml-3 text-xs font-semibold text-blue-600 animate-pulse";
            statusLabel.innerText = "Mengecek koneksi server & mengirim email...";

            const data = {
                smtpHost: document.getElementById('smtpHost').value,
                smtpPort: document.getElementById('smtpPort').value,
                smtpUser: document.getElementById('smtpUser').value,
                smtpPass: document.getElementById('smtpPass').value,
                emailTarget: document.getElementsByName('emailTarget')[0].value
            };

            fetch('/settings/test-smtp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            })
            .then(response => response.json())
            .then(res => {
                if (res.success) {
                    statusLabel.className = "ml-3 text-xs font-semibold text-green-600";
                    statusLabel.innerText = "✅ " + res.message;
                } else {
                    statusLabel.className = "ml-3 text-xs font-semibold text-red-600";
                    statusLabel.innerText = "❌ " + res.message;
                }
            })
            .catch(err => {
                statusLabel.className = "ml-3 text-xs font-semibold text-red-600";
                statusLabel.innerText = "❌ Terjadi kesalahan jaringan.";
            });
        }

        function testZoho() {
            const label = document.getElementById('testZohoStatus');
            label.className = "ml-3 text-xs font-semibold text-blue-600 animate-pulse";
            label.innerText = "Menghubungi Zoho Books...";
            fetch('/settings/zoho/test', { method: 'POST' })
                .then(r => r.json())
                .then(res => {
                    label.className = "ml-3 text-xs font-semibold " + (res.success ? "text-green-600" : "text-red-600");
                    let text = (res.success ? "✅ " : "❌ ") + res.message;
                    if (!res.success && res.availableFields && res.availableFields.length) {
                        text += " | Field tersedia: " + res.availableFields.map(f => f.api_name).join(', ');
                    }
                    label.innerText = text;
                })
                .catch(() => {
                    label.className = "ml-3 text-xs font-semibold text-red-600";
                    label.innerText = "❌ Terjadi kesalahan jaringan.";
                });
        }

        // Jalankan fungsi saat halaman pertama kali dimuat agar menyesuaikan dengan data tersimpan
        window.onload = function() {
            toggleSmtpForm();
        };
    </script>
</body>
</html>
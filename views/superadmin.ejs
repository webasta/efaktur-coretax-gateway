<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Superadmin Panel - eFaktur System</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 font-sans">

    <!-- Navbar Superadmin -->
    <nav class="bg-slate-800 text-white shadow-md px-6 py-4 flex justify-between items-center">
        <div class="flex items-center space-x-3">
            <span class="text-2xl">👑</span>
            <h1 class="text-xl font-bold">e-Faktur SaaS Superadmin Control</h1>
        </div>
        <div class="flex items-center space-x-4">
            <a href="/dashboard" class="text-sm font-semibold bg-slate-700 hover:bg-slate-600 px-3 py-1.5 rounded transition">📊 Ke Dashboard</a>
            <a href="/logout" class="bg-red-500 hover:bg-red-600 text-xs font-semibold px-3 py-1.5 rounded transition">Logout</a>
        </div>
    </nav>

    <!-- Konten Utama -->
    <main class="max-w-6xl mx-auto p-6 grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <!-- Status Toast Notifikasi -->
        <div class="lg:col-span-3">
            <% if (success) { %> <div class="bg-green-100 text-green-800 border border-green-200 px-4 py-3 rounded-xl mb-2 text-sm"><%= success %></div> <% } %>
            <% if (error) { %> <div class="bg-red-100 text-red-800 border border-red-200 px-4 py-3 rounded-xl mb-2 text-sm">⚠️ <%= error %></div> <% } %>
        </div>

        <!-- KOLOM KIRI: FORM TAMBAH KLIEN BARU -->
        <div class="bg-white rounded-xl shadow-sm border p-6 h-fit">
            <h3 class="text-lg font-bold text-gray-800 border-b pb-3 mb-4">➕ Daftarkan Klien Baru</h3>
            <form action="/superadmin/add-user" method="POST" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Nama Perusahaan Klien</label>
                    <input type="text" name="companyName" required placeholder="PT. Sukses Selalu" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-slate-800">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Username Akun</label>
                    <input type="text" name="username" required placeholder="klien_sukses" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-slate-800">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Password Awal Akun</label>
                    <input type="password" name="password" required placeholder="Masukkan password kuat" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-slate-800">
                </div>
                <button type="submit" class="w-full bg-slate-800 hover:bg-slate-900 text-white font-bold py-2 rounded-lg text-sm transition">
                    🚀 Daftarkan Klien
                </button>
            </form>
        </div>

        <!-- KOLOM KANAN: TABEL MANAJEMEN USER KLIEN -->
        <div class="lg:col-span-2 bg-white rounded-xl shadow-sm border p-6">
            <h3 class="text-lg font-bold text-gray-800 border-b pb-3 mb-4">👥 Daftar Klien Aktif & Manajemen Akses</h3>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-gray-600">
                    <thead class="bg-gray-50 text-xs font-semibold text-gray-700 uppercase">
                        <tr>
                            <th class="px-4 py-3">Klien / Perusahaan</th>
                            <th class="px-4 py-3">API Key (Zoho Query)</th>
                            <th class="px-4 py-3">Ubah Status / Reset Password</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200">
                        <% clients.forEach(client => { %>
                            <tr class="hover:bg-gray-50/70">
                                <td class="px-4 py-4">
                                    <div class="font-bold text-gray-900"><%= client.companyName %></div>
                                    <div class="text-xs text-gray-500 font-mono">User: @<%= client.username %></div>
                                    <% if (client.username === 'admin') { %>
                                        <span class="inline-block bg-purple-100 text-purple-800 text-[10px] px-2 py-0.5 rounded font-semibold mt-1">Superadmin</span>
                                    <% } else { %>
                                        <span class="inline-block text-[10px] px-2 py-0.5 rounded font-semibold mt-1 <%= client.status === 'active' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                                            <%= client.status === 'active' ? 'Aktif / Active' : 'Ditangguhkan / Suspend' %>
                                        </span>
                                    <% } %>
                                </td>
                                <td class="px-4 py-4">
                                    <input type="text" readonly value="<%= client.apiKey %>" class="w-full bg-gray-50 border border-gray-200 text-xs font-mono px-2 py-1 rounded select-all focus:outline-none">
                                </td>
                                <td class="px-4 py-4">
                                    <% if (client.username !== 'admin') { %>
                                        <form action="/superadmin/update-user/<%= client.id %>" method="POST" class="space-y-2">
                                            <div class="flex space-x-1">
                                                <select name="status" onchange="this.form.submit()" class="text-xs border rounded p-1 bg-white focus:outline-none">
                                                    <option value="active" <%= client.status === 'active' ? 'selected' : '' %>>Aktif</option>
                                                    <option value="inactive" <%= client.status === 'inactive' ? 'selected' : '' %>>Suspend</option>
                                                </select>
                                                <input type="text" name="newPassword" placeholder="Password Baru" class="text-xs border rounded p-1 w-28 focus:outline-none">
                                                <button type="submit" class="bg-amber-500 text-white text-[11px] px-2 py-1 rounded font-bold hover:bg-amber-600 transition">Reset</button>
                                            </div>
                                        </form>
                                    <% } else { %>
                                        <span class="text-xs text-gray-400 italic">Tidak dapat diubah</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</body>
</html>
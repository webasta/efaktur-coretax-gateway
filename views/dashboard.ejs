<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Dashboard - e-Faktur Gateway</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { font-feature-settings: "cv11", "ss01"; }
        .tab-panel { display: none; }
        .tab-panel.active { display: block; }
    </style>
</head>
<%
    const counts = { baru: sections.baru.length, upload: sections.upload.length, lengkap: sections.lengkap.length, gagal: failedCount };
    const rp = (n) => 'Rp ' + Number(n || 0).toLocaleString('id-ID');

    const zohoBadge = (l) => {
        const z = l.zohoSync || {};
        if (z.state === 'synced') return ['bg-emerald-50 text-emerald-700 ring-emerald-600/20', 'Zoho ✓'];
        if (z.state === 'xml_marked') return ['bg-sky-50 text-sky-700 ring-sky-600/20', 'XML di Zoho'];
        if (z.state === 'failed') return ['bg-red-50 text-red-700 ring-red-600/20', 'Zoho gagal'];
        if (z.state === 'pending') return ['bg-amber-50 text-amber-700 ring-amber-600/20', 'Zoho tertunda'];
        return ['bg-slate-50 text-slate-500 ring-slate-500/20', 'Belum ke Zoho'];
    };
    const stageChip = {
        baru: ['bg-sky-50 text-sky-700 ring-sky-600/20', 'Baru Rilis'],
        upload: ['bg-amber-50 text-amber-700 ring-amber-600/20', 'Perlu Upload'],
        lengkap: ['bg-emerald-50 text-emerald-700 ring-emerald-600/20', 'Lengkap'],
        gagal: ['bg-red-50 text-red-700 ring-red-600/20', 'Gagal']
    };
    const btn = "inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-xs font-semibold transition whitespace-nowrap";
    const btnPrimary = btn + " bg-indigo-600 text-white hover:bg-indigo-700 shadow-sm";
    const btnGhost = btn + " bg-white text-slate-700 ring-1 ring-inset ring-slate-200 hover:bg-slate-50";
    const chip = "inline-flex items-center rounded-md px-2 py-0.5 text-xs font-medium ring-1 ring-inset";
%>
<body class="bg-slate-50 text-slate-800 antialiased">

    <%- include('partials/sidebar', { active: 'dashboard', username, companyName, counts }) %>

    <div class="lg:pl-64">
        <main class="max-w-6xl mx-auto px-4 sm:px-8 py-8 space-y-8">

            <!-- HEADER -->
            <header class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 pt-8 lg:pt-0">
                <div>
                    <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Dashboard Faktur</h1>
                    <p class="text-sm text-slate-500 mt-1">Pantau invoice Zoho Books dari XML terbit sampai Faktur Pajak lengkap.</p>
                </div>
                <div class="flex items-center gap-3 text-xs">
                    <% if (zohoEnabled) { %>
                        <span class="<%= chip %> bg-emerald-50 text-emerald-700 ring-emerald-600/20">● Zoho Books terhubung</span>
                    <% } else { %>
                        <a href="/settings#zoho" class="<%= chip %> bg-amber-50 text-amber-700 ring-amber-600/20 hover:bg-amber-100">○ Zoho belum aktif — atur</a>
                    <% } %>
                    <span class="flex items-center gap-1.5 text-slate-400">
                        <span class="relative flex h-2 w-2"><span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-60"></span><span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span></span>
                        Live
                    </span>
                </div>
            </header>

            <!-- KARTU TAHAP -->
            <section class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <% [
                    ['baru', '1', 'Baru Rilis', 'XML terbit, belum diunggah ke Coretax', 'sky'],
                    ['upload', '2', 'Perlu Upload Faktur', 'Menunggu nomor & PDF Faktur Pajak', 'amber'],
                    ['lengkap', '3', 'Sudah Lengkap', 'Faktur Pajak lengkap di Zoho', 'emerald']
                ].forEach(([key, num, title, desc, color]) => { %>
                    <button type="button" data-tab-card="<%= key %>" onclick="showTab('<%= key %>')"
                        class="stage-card text-left bg-white rounded-xl border border-slate-200 p-5 hover:border-<%= color %>-300 hover:shadow-sm transition focus:outline-none">
                        <div class="flex items-center justify-between">
                            <span class="inline-flex items-center gap-2 text-xs font-semibold text-<%= color %>-700">
                                <span class="h-5 w-5 rounded-full bg-<%= color %>-100 flex items-center justify-center text-[11px]"><%= num %></span>
                                Tahap <%= num %>
                            </span>
                            <span class="text-3xl font-bold text-slate-900 tabular-nums"><%= counts[key] %></span>
                        </div>
                        <div class="mt-3 text-sm font-semibold text-slate-900"><%= title %></div>
                        <div class="text-xs text-slate-500 mt-0.5"><%= desc %></div>
                        <div class="stage-bar mt-4 h-1 rounded-full bg-slate-100"><div class="h-1 rounded-full bg-<%= color %>-500 w-0 transition-all"></div></div>
                    </button>
                <% }) %>
            </section>

            <!-- PANEL TAHAP -->
            <section class="bg-white rounded-xl border border-slate-200 overflow-hidden">
                <% function row(l) { const [zc, zt] = zohoBadge(l); const f = l.faktur || {}; %>
                    <li class="px-5 py-4 flex flex-col md:flex-row md:items-center gap-3 md:gap-6 hover:bg-slate-50/60">
                        <div class="min-w-0 flex-1">
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="font-mono text-sm font-semibold text-slate-900"><%= l.invoiceNumber %></span>
                                <span class="<%= chip %> <%= zc %>" title="<%= (l.zohoSync && l.zohoSync.message) || '' %>"><%= zt %></span>
                            </div>
                            <div class="text-sm text-slate-500 mt-0.5 truncate">
                                <%= l.customerName %> · <%= rp(l.totalAmount) %> · PPN <%= rp(l.totalVat) %>
                            </div>
                            <% if (l.stage === 'upload' && l.missing.length) { %>
                                <div class="mt-1.5 text-xs text-amber-700">Belum ada: <%= l.missing.join(' & ') %><% if (f.number) { %> · No. <span class="font-mono"><%= f.number %></span><% } %></div>
                            <% } %>
                            <% if (l.stage === 'lengkap') { %>
                                <div class="mt-1.5 text-xs text-slate-600">
                                    No. <span class="font-mono font-semibold text-slate-800"><%= f.number %></span> · <%= f.date || '-' %> · <%= f.status || '-' %> · 📎 PDF
                                </div>
                            <% } %>
                            <% if (l.zohoSync && l.zohoSync.state === 'failed') { %>
                                <div class="mt-1.5 text-xs text-red-600 line-clamp-2"><%= l.zohoSync.message %></div>
                            <% } %>
                        </div>
                        <div class="flex flex-wrap items-center gap-2 md:justify-end shrink-0">
                            <% if (l.stage === 'baru') { %>
                                <% if (l.hasXml) { %><a href="/download-xml/<%= l.id %>" onclick="afterDownload()" class="<%= btnGhost %>">⤓ Unduh XML</a><% } %>
                                <button type="button" onclick="markCoretax(<%= l.id %>, true, this)" class="<%= btnPrimary %>">Sudah diunggah ke Coretax →</button>
                            <% } else if (l.stage === 'upload') { %>
                                <% if (l.hasXml) { %><a href="/download-xml/<%= l.id %>" class="<%= btnGhost %>">⤓ XML</a><% } %>
                                <% if (!f.number) { %><button type="button" onclick="markCoretax(<%= l.id %>, false, this)" class="<%= btnGhost %>" title="Kembalikan ke Baru Rilis">↩</button><% } %>
                                <button type="button" onclick="openFakturModal(this)" data-id="<%= l.id %>" data-invoice="<%= l.invoiceNumber %>" data-number="<%= f.number || '' %>" data-date="<%= f.date || '' %>" data-status="<%= f.status || '' %>" class="<%= btnPrimary %>">⇪ Upload Faktur</button>
                            <% } else { %>
                                <% if (l.hasXml) { %><a href="/download-xml/<%= l.id %>" class="<%= btnGhost %>">⤓ XML</a><% } %>
                                <button type="button" onclick="openFakturModal(this)" data-id="<%= l.id %>" data-invoice="<%= l.invoiceNumber %>" data-number="<%= f.number || '' %>" data-date="<%= f.date || '' %>" data-status="<%= f.status || '' %>" class="<%= btnGhost %>">Ubah</button>
                                <button type="button" onclick="resync(<%= l.id %>, this)" class="<%= btnGhost %>">↻ Sinkron</button>
                            <% } %>
                        </div>
                    </li>
                <% } %>

                <% [
                    ['baru', 'Baru Rilis', 'Unduh XML lalu unggah ke Coretax (atau pakai XML dari email). Setelah itu klik “Sudah diunggah ke Coretax”.', 'Tidak ada XML baru. Invoice akan muncul di sini otomatis setelah berstatus Sent di Zoho Books.'],
                    ['upload', 'Perlu Upload Faktur', 'Setelah faktur di-approve di Coretax, unggah nomor & PDF Faktur Pajak per invoice, atau impor sekaligus dari Excel Coretax.', 'Tidak ada yang menunggu. Semua faktur sudah lengkap.'],
                    ['lengkap', 'Sudah Lengkap', 'Nomor, tanggal, status, dan PDF Faktur Pajak sudah tercatat dan dikirim ke invoice Zoho Books.', 'Belum ada faktur yang lengkap.']
                ].forEach(([key, title, help, empty]) => { %>
                    <div class="tab-panel" data-panel="<%= key %>">
                        <div class="px-5 py-4 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                            <div>
                                <h2 class="text-base font-semibold text-slate-900"><%= title %> <span class="text-slate-400 font-normal">(<%= counts[key] %>)</span></h2>
                                <p class="text-xs text-slate-500 mt-0.5 max-w-2xl"><%= help %></p>
                            </div>
                            <% if (key === 'upload') { %>
                                <button type="button" onclick="openImport()" class="<%= btnGhost %>">⇪ Impor dari Excel Coretax</button>
                            <% } %>
                        </div>
                        <% if (sections[key].length === 0) { %>
                            <div class="px-5 py-14 text-center text-sm text-slate-400"><%= empty %></div>
                        <% } else { %>
                            <ul class="divide-y divide-slate-100">
                                <% sections[key].forEach(l => row(l)) %>
                            </ul>
                        <% } %>
                    </div>
                <% }) %>
            </section>

            <!-- RIWAYAT -->
            <section id="riwayat" class="bg-white rounded-xl border border-slate-200 overflow-hidden scroll-mt-6">
                <div class="px-5 py-4 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                    <div>
                        <h2 class="text-base font-semibold text-slate-900">Riwayat</h2>
                        <p class="text-xs text-slate-500 mt-0.5">Semua webhook & sinkronisasi<%= totalLogs > logs.length ? ` (${logs.length} terbaru dari ${totalLogs})` : '' %>.</p>
                    </div>
                    <div class="flex items-center gap-2">
                        <select id="histFilter" onchange="filterHistory()" class="rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-xs text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500/30">
                            <option value="">Semua tahap</option>
                            <option value="baru">Baru Rilis</option>
                            <option value="upload">Perlu Upload</option>
                            <option value="lengkap">Lengkap</option>
                            <option value="gagal">Gagal</option>
                        </select>
                        <input id="histSearch" oninput="filterHistory()" type="search" placeholder="Cari invoice / pelanggan / no. faktur"
                            class="w-60 rounded-lg border border-slate-200 px-3 py-1.5 text-xs focus:outline-none focus:ring-2 focus:ring-indigo-500/30">
                    </div>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm">
                        <thead class="bg-slate-50 text-[11px] font-semibold uppercase tracking-wider text-slate-500">
                            <tr>
                                <th class="px-5 py-2.5">Waktu</th>
                                <th class="px-5 py-2.5">Invoice</th>
                                <th class="px-5 py-2.5">Pelanggan</th>
                                <th class="px-5 py-2.5 text-right">PPN</th>
                                <th class="px-5 py-2.5">Tahap</th>
                                <th class="px-5 py-2.5">Faktur Pajak</th>
                                <th class="px-5 py-2.5">Zoho</th>
                                <th class="px-5 py-2.5"></th>
                            </tr>
                        </thead>
                        <tbody id="histBody" class="divide-y divide-slate-100">
                            <% if (logs.length === 0) { %>
                                <tr><td colspan="8" class="px-5 py-12 text-center text-sm text-slate-400">Belum ada data webhook masuk dari Zoho Books.</td></tr>
                            <% } %>
                            <% logs.forEach(l => { const [sc, st] = stageChip[l.stage]; const [zc, zt] = zohoBadge(l); const f = l.faktur || {}; %>
                                <tr class="hist-row hover:bg-slate-50/60 align-top" data-stage="<%= l.stage %>"
                                    data-search="<%= [l.invoiceNumber, l.customerName, f.number].filter(Boolean).join(' ').toLowerCase() %>">
                                    <td class="px-5 py-3 text-xs text-slate-500 whitespace-nowrap"><%= l.timestamp %></td>
                                    <td class="px-5 py-3 font-mono text-xs font-semibold text-slate-800 whitespace-nowrap"><%= l.invoiceNumber %></td>
                                    <td class="px-5 py-3 text-slate-600"><%= l.customerName %></td>
                                    <td class="px-5 py-3 text-right tabular-nums text-slate-700 whitespace-nowrap"><%= rp(l.totalVat) %></td>
                                    <td class="px-5 py-3"><span class="<%= chip %> <%= sc %>"><%= st %></span></td>
                                    <td class="px-5 py-3 text-xs">
                                        <% if (f.number) { %><span class="font-mono text-slate-800"><%= f.number %></span><% } else if (l.stage === 'gagal') { %>
                                            <span class="text-red-600 line-clamp-2 max-w-xs" title="<%= l.status %>"><%= l.status %></span>
                                        <% } else { %><span class="text-slate-300">—</span><% } %>
                                    </td>
                                    <td class="px-5 py-3">
                                        <% if (l.stage !== 'gagal') { %><span class="<%= chip %> <%= zc %>" title="<%= (l.zohoSync && l.zohoSync.message) || '' %>"><%= zt %></span><% } %>
                                    </td>
                                    <td class="px-5 py-3 text-right whitespace-nowrap">
                                        <% if (l.hasXml) { %><a href="/download-xml/<%= l.id %>" class="text-xs font-semibold text-indigo-600 hover:text-indigo-800">XML</a><% } %>
                                        <% if (l.stage !== 'gagal') { %><button type="button" onclick="resync(<%= l.id %>, this)" class="ml-3 text-xs font-semibold text-slate-500 hover:text-slate-800">Sinkron</button><% } %>
                                    </td>
                                </tr>
                            <% }) %>
                            <tr id="histEmpty" class="hidden"><td colspan="8" class="px-5 py-10 text-center text-sm text-slate-400">Tidak ada yang cocok.</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>
        </main>
    </div>

    <!-- MODAL: UPLOAD FAKTUR -->
    <div id="fakturModal" class="hidden fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-[1px] flex items-center justify-center p-4">
        <form onsubmit="submitFaktur(event)" class="bg-white rounded-2xl shadow-xl w-full max-w-md overflow-hidden">
            <div class="px-6 pt-6">
                <h3 class="text-base font-semibold text-slate-900">Upload Faktur Pajak</h3>
                <p class="text-xs text-slate-500 mt-1">Invoice <span id="modalInvoice" class="font-mono font-semibold text-slate-700"></span> — data dikirim ke Zoho Books.</p>
            </div>
            <div class="px-6 py-5 space-y-4">
                <input type="hidden" id="modalLogId">
                <div>
                    <label class="block text-xs font-medium text-slate-600 mb-1">Nomor Faktur Pajak</label>
                    <input type="text" id="modalNumber" required inputmode="numeric" placeholder="17 digit, mis. 04002600000000123"
                        class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500">
                    <p id="modalNumberHint" class="text-[11px] text-slate-400 mt-1"></p>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-medium text-slate-600 mb-1">Tanggal Faktur</label>
                        <input type="date" id="modalDate" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-slate-600 mb-1">Status Coretax</label>
                        <select id="modalStatus" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500">
                            <option>Approved</option><option>Created</option><option>Amended</option><option>Canceled</option>
                        </select>
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-600 mb-1">PDF Faktur Pajak</label>
                    <label class="flex items-center gap-3 rounded-lg border border-dashed border-slate-300 px-3 py-3 cursor-pointer hover:border-indigo-400 hover:bg-indigo-50/30">
                        <span class="text-lg">📄</span>
                        <span id="modalPdfName" class="text-sm text-slate-500 truncate">Pilih file PDF dari Coretax…</span>
                        <input type="file" id="modalPdf" accept="application/pdf" class="hidden" onchange="document.getElementById('modalPdfName').innerText = this.files[0] ? this.files[0].name : 'Pilih file PDF dari Coretax…'">
                    </label>
                    <p class="text-[11px] text-slate-400 mt-1">Invoice pindah ke “Sudah Lengkap” setelah nomor & PDF tersimpan.</p>
                </div>
                <div id="modalMsg" class="text-xs font-medium"></div>
            </div>
            <div class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex justify-end gap-2">
                <button type="button" onclick="closeModal('fakturModal')" class="<%= btnGhost %>">Batal</button>
                <button type="submit" id="modalSubmit" class="<%= btnPrimary %>">Simpan & kirim ke Zoho</button>
            </div>
        </form>
    </div>

    <!-- MODAL: IMPOR EXCEL CORETAX -->
    <div id="importModal" class="hidden fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-[1px] flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-4xl overflow-hidden">
            <div class="px-6 pt-6 flex items-start justify-between gap-4">
                <div>
                    <h3 class="text-base font-semibold text-slate-900">Impor dari Excel Coretax</h3>
                    <p class="text-xs text-slate-500 mt-1 max-w-2xl">Unduh daftar Faktur Keluaran dari Coretax (Excel/CSV). Baris dicocokkan lewat kolom <b>Referensi</b> (= nomor invoice Zoho); nomor, tanggal, dan status faktur dikirim ke Zoho. PDF tetap diunggah per invoice.</p>
                </div>
                <button type="button" onclick="closeModal('importModal')" class="text-slate-400 hover:text-slate-700 text-xl leading-none">×</button>
            </div>
            <div class="px-6 py-5 space-y-4">
                <div class="flex flex-wrap items-center gap-3">
                    <input type="file" id="importFile" accept=".csv,.xlsx,.txt" class="text-sm file:mr-3 file:rounded-lg file:border-0 file:bg-slate-100 file:px-3 file:py-1.5 file:text-xs file:font-semibold file:text-slate-700 hover:file:bg-slate-200">
                    <button type="button" onclick="sendImport(true)" class="<%= btnGhost %>">Pratinjau</button>
                    <button type="button" id="applyBtn" onclick="sendImport(false)" disabled class="<%= btnPrimary %> disabled:opacity-40 disabled:cursor-not-allowed">Kirim ke Zoho</button>
                    <label class="inline-flex items-center text-xs text-slate-600"><input type="checkbox" id="forceImport" class="mr-1.5 rounded"> Kirim ulang yang tidak berubah</label>
                </div>
                <div id="importStatus" class="text-xs font-medium"></div>
                <div id="importPreview" class="hidden overflow-auto max-h-80 rounded-lg border border-slate-200">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-slate-50 text-slate-500 uppercase sticky top-0">
                            <tr><th class="px-3 py-2">Baris</th><th class="px-3 py-2">Referensi</th><th class="px-3 py-2">No. Faktur</th><th class="px-3 py-2">Tanggal</th><th class="px-3 py-2">Status</th><th class="px-3 py-2">Tindakan</th><th class="px-3 py-2">Keterangan</th></tr>
                        </thead>
                        <tbody id="importRows" class="divide-y divide-slate-100"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script>
        const esc = (s) => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
        let busy = false;

        // ---------- Tab tahap ----------
        const TABS = ['baru', 'upload', 'lengkap'];
        const RING = { baru: 'ring-sky-400', upload: 'ring-amber-400', lengkap: 'ring-emerald-400' };
        function showTab(key, scroll) {
            if (!TABS.includes(key)) key = 'baru';
            document.querySelectorAll('[data-panel]').forEach(p => p.classList.toggle('active', p.dataset.panel === key));
            document.querySelectorAll('[data-tab-card]').forEach(c => {
                const on = c.dataset.tabCard === key;
                c.classList.toggle('ring-2', on);
                Object.values(RING).forEach(r => c.classList.remove(r));
                if (on) c.classList.add(RING[key]);
                c.querySelector('.stage-bar > div').style.width = on ? '100%' : '0';
            });
            document.querySelectorAll('[data-tab]').forEach(a => {
                const on = a.dataset.tab === key;
                a.classList.toggle('bg-indigo-50', on);
                a.classList.toggle('text-indigo-700', on);
            });
            if (location.hash !== '#' + key) history.replaceState(null, '', '#' + key);
            if (scroll) document.querySelector('[data-panel="' + key + '"]').scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
        document.querySelectorAll('[data-tab]').forEach(a => a.addEventListener('click', e => {
            e.preventDefault(); showTab(a.dataset.tab, true); closeSidebarMobile();
        }));
        document.querySelectorAll('[data-scroll]').forEach(a => a.addEventListener('click', e => {
            e.preventDefault(); document.getElementById(a.dataset.scroll).scrollIntoView({ behavior: 'smooth' }); closeSidebarMobile();
        }));
        document.querySelectorAll('[data-open="impor"]').forEach(a => a.addEventListener('click', e => {
            e.preventDefault(); openImport(); closeSidebarMobile();
        }));
        function closeSidebarMobile() {
            if (window.innerWidth < 1024) document.getElementById('sidebar').classList.add('-translate-x-full');
        }

        const initial = location.hash.slice(1);
        if (initial === 'impor') { showTab('upload'); openImport(); }
        else if (initial === 'riwayat') { showTab('baru'); setTimeout(() => document.getElementById('riwayat').scrollIntoView(), 50); }
        else showTab(initial || '<%= counts.baru ? "baru" : (counts.upload ? "upload" : "baru") %>');

        // ---------- Riwayat ----------
        function filterHistory() {
            const q = document.getElementById('histSearch').value.trim().toLowerCase();
            const st = document.getElementById('histFilter').value;
            let shown = 0;
            document.querySelectorAll('.hist-row').forEach(r => {
                const ok = (!st || r.dataset.stage === st) && (!q || r.dataset.search.includes(q));
                r.classList.toggle('hidden', !ok);
                if (ok) shown++;
            });
            document.getElementById('histEmpty').classList.toggle('hidden', shown > 0 || document.querySelectorAll('.hist-row').length === 0);
        }

        // ---------- Util ----------
        const readFileBase64 = (file) => new Promise((resolve, reject) => {
            const r = new FileReader();
            r.onload = () => resolve(r.result);
            r.onerror = () => reject(r.error);
            r.readAsDataURL(file);
        });
        const postJson = async (url, body) => {
            const res = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body || {}) });
            return res.json().catch(() => ({ success: false, message: 'Respons server tidak valid' }));
        };
        function closeModal(id) { document.getElementById(id).classList.add('hidden'); busy = false; }

        // ---------- Aksi baris ----------
        async function markCoretax(id, uploaded, el) {
            el.disabled = true;
            const data = await postJson(`/logs/${id}/coretax`, { uploaded });
            if (!data.success) { alert(data.message); el.disabled = false; return; }
            location.reload();
        }
        function afterDownload() { setTimeout(() => location.reload(), 1200); }
        async function resync(id, el) {
            el.disabled = true;
            const old = el.innerText;
            el.innerText = '…';
            const data = await postJson(`/logs/${id}/resync`);
            if (!data.success) alert(data.message);
            el.innerText = old;
            location.reload();
        }

        // ---------- Modal faktur ----------
        function openFakturModal(b) {
            busy = true;
            document.getElementById('modalLogId').value = b.dataset.id;
            document.getElementById('modalInvoice').innerText = b.dataset.invoice;
            document.getElementById('modalNumber').value = b.dataset.number;
            document.getElementById('modalDate').value = b.dataset.date || new Date().toISOString().slice(0, 10);
            document.getElementById('modalStatus').value = b.dataset.status || 'Approved';
            document.getElementById('modalPdf').value = '';
            document.getElementById('modalPdfName').innerText = 'Pilih file PDF dari Coretax…';
            document.getElementById('modalMsg').innerText = '';
            checkNumber();
            document.getElementById('fakturModal').classList.remove('hidden');
            document.getElementById('modalNumber').focus();
        }
        function checkNumber() {
            const d = document.getElementById('modalNumber').value.replace(/\D/g, '');
            const hint = document.getElementById('modalNumberHint');
            hint.className = 'text-[11px] mt-1 ' + (d && d.length !== 17 ? 'text-amber-600' : 'text-slate-400');
            hint.innerText = d ? `${d.length} digit${d.length !== 17 ? ' — NSFP Coretax umumnya 17 digit' : ''}` : '';
        }
        document.getElementById('modalNumber').addEventListener('input', checkNumber);
        async function submitFaktur(e) {
            e.preventDefault();
            const msg = document.getElementById('modalMsg');
            const btn = document.getElementById('modalSubmit');
            btn.disabled = true;
            msg.className = 'text-xs font-medium text-indigo-600';
            msg.innerText = 'Mengirim ke Zoho Books…';
            try {
                const pdf = document.getElementById('modalPdf').files[0];
                const data = await postJson(`/logs/${document.getElementById('modalLogId').value}/faktur`, {
                    fakturNumber: document.getElementById('modalNumber').value.replace(/\D/g, ''),
                    fakturDate: document.getElementById('modalDate').value,
                    status: document.getElementById('modalStatus').value,
                    pdfBase64: pdf ? await readFileBase64(pdf) : null,
                    pdfFilename: pdf ? pdf.name : null
                });
                if (data.success || data.pending) { location.reload(); return; }
                throw new Error(data.message);
            } catch (err) {
                msg.className = 'text-xs font-medium text-red-600';
                msg.innerText = err.message + ' (data tetap tersimpan; bisa dicoba lagi lewat Sinkron)';
            } finally { btn.disabled = false; }
        }

        // ---------- Modal impor ----------
        function openImport() { busy = true; document.getElementById('importModal').classList.remove('hidden'); }
        const ACTION_LABEL = {
            sync: '<span class="text-indigo-700 font-semibold">Kirim</span>',
            lookup: '<span class="text-violet-700 font-semibold">Cari di Zoho & kirim</span>',
            unchanged: '<span class="text-slate-400">Tidak berubah</span>',
            skip: '<span class="text-red-600">Lewati</span>'
        };
        function renderImportRows(records, applied) {
            document.getElementById('importPreview').classList.remove('hidden');
            document.getElementById('importRows').innerHTML = records.map(r => {
                let action = ACTION_LABEL[r.action] || esc(r.action);
                if (applied && r.action !== 'skip' && r.action !== 'unchanged') {
                    action = r.ok ? '<span class="text-emerald-700 font-semibold">✓ Terkirim</span>' : '<span class="text-red-700 font-semibold">✕ Gagal</span>';
                }
                return `<tr><td class="px-3 py-1.5 text-slate-400">${esc(r.row)}</td><td class="px-3 py-1.5 font-mono">${esc(r.reference)}</td>
                    <td class="px-3 py-1.5 font-mono">${esc(r.fakturNumber)}</td><td class="px-3 py-1.5">${esc(r.fakturDate)}</td>
                    <td class="px-3 py-1.5">${esc(r.status)}</td><td class="px-3 py-1.5">${action}</td>
                    <td class="px-3 py-1.5 text-slate-500">${esc(applied ? (r.message || r.note) : r.note)}</td></tr>`;
            }).join('') || '<tr><td colspan="7" class="px-3 py-4 text-center text-slate-400">Tidak ada baris data</td></tr>';
        }
        async function sendImport(dryRun) {
            const file = document.getElementById('importFile').files[0];
            const status = document.getElementById('importStatus');
            if (!file) { status.className = 'text-xs font-medium text-red-600'; status.innerText = 'Pilih file dulu.'; return; }
            status.className = 'text-xs font-medium text-indigo-600';
            status.innerText = dryRun ? 'Membaca file…' : 'Mengirim ke Zoho Books…';
            try {
                const data = await postJson('/coretax/import', {
                    filename: file.name, contentBase64: await readFileBase64(file),
                    dryRun, force: document.getElementById('forceImport').checked
                });
                if (!data.success) throw new Error(data.message);
                renderImportRows(data.records, !dryRun);
                if (dryRun) {
                    const n = data.records.filter(r => r.action === 'sync' || r.action === 'lookup').length;
                    status.className = 'text-xs font-medium text-slate-700';
                    status.innerText = `${data.records.length} baris terbaca, ${n} siap dikirim.`;
                    document.getElementById('applyBtn').disabled = n === 0 && !document.getElementById('forceImport').checked;
                } else {
                    const s = data.summary;
                    status.className = 'text-xs font-medium ' + (s.failed ? 'text-amber-700' : 'text-emerald-700');
                    status.innerText = `Selesai: ${s.synced} terkirim, ${s.unchanged} tidak berubah, ${s.failed} gagal, ${s.skipped} dilewati. Tutup jendela ini untuk memperbarui daftar.`;
                    document.getElementById('applyBtn').disabled = true;
                    document.querySelector('#importModal button[onclick^="closeModal"]').onclick = () => location.reload();
                }
            } catch (e) {
                status.className = 'text-xs font-medium text-red-600';
                status.innerText = e.message;
            }
        }

        // ---------- Auto refresh ----------
        let lastVersion = null;
        const initialCount = <%= totalLogs %>;
        setInterval(() => {
            if (busy || document.hidden) return;
            fetch('/api/logs/count').then(r => r.json()).then(d => {
                if (lastVersion === null) lastVersion = d.version;
                if (d.count !== initialCount || d.version !== lastVersion) location.reload();
            }).catch(() => {});
        }, 3000);
    </script>
</body>
</html>

<!DOCTYPE html>
<html lang="id">
<head><%- include('partials/head', { title: 'Dashboard' }) %></head>
<body class="bg-slate-50 text-slate-800 antialiased">
<%- include('partials/sidebar') %>

<div class="lg:pl-60">
<main class="max-w-6xl mx-auto px-4 sm:px-8 py-8 pt-16 lg:pt-8 space-y-6">

    <!-- Header + filter periode -->
    <header class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Dashboard</h1>
            <p class="text-sm text-slate-500 mt-1">Ringkasan Faktur Pajak dari invoice Zoho Books.</p>
        </div>
        <div class="flex items-center gap-3">
            <% if (!zohoEnabled) { %>
                <a href="/settings#zoho" class="<%= ui.chip %> bg-amber-50 text-amber-700 ring-amber-600/20">Zoho belum terhubung</a>
            <% } %>
            <div class="inline-flex rounded-lg bg-white p-1 ring-1 ring-slate-200 shadow-sm">
                <% ranges.forEach(r => { %>
                    <a href="/dashboard?range=<%= r %>"
                       class="px-3 py-1.5 text-xs font-semibold rounded-md transition <%= r === range ? 'bg-indigo-600 text-white shadow-sm' : 'text-slate-600 hover:bg-slate-100' %>">
                        <%= r %> hari
                    </a>
                <% }) %>
            </div>
        </div>
    </header>

    <% if (stats.failed) { %>
        <a href="/riwayat?range=<%= range %>" class="flex items-center justify-between rounded-xl bg-red-50 ring-1 ring-red-100 px-4 py-3 text-sm text-red-800 hover:bg-red-100/60">
            <span><b><%= stats.failed %></b> webhook gagal dalam <%= range %> hari terakhir (mis. email/SMTP).</span>
            <span class="text-xs font-semibold">Lihat riwayat →</span>
        </a>
    <% } %>

    <!-- KPI -->
    <section class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white rounded-xl ring-1 ring-slate-200 p-5">
            <div class="text-xs font-medium text-slate-500">Total Invoice</div>
            <div class="mt-2 text-3xl font-bold text-slate-900 tabular-nums"><%= stats.total %></div>
            <div class="mt-1 text-xs text-slate-400"><%= range %> hari terakhir</div>
        </div>
        <a href="/pending" class="bg-white rounded-xl ring-1 ring-slate-200 p-5 hover:ring-amber-300 transition">
            <div class="flex items-center gap-2 text-xs font-medium text-slate-500"><span class="h-2 w-2 rounded-full bg-amber-400"></span>Pending</div>
            <div class="mt-2 text-3xl font-bold text-slate-900 tabular-nums"><%= stats.pending %></div>
            <div class="mt-1 text-xs text-slate-400"><%= counts.pending %> total menunggu FP</div>
        </a>
        <a href="/completed" class="bg-white rounded-xl ring-1 ring-slate-200 p-5 hover:ring-emerald-300 transition">
            <div class="flex items-center gap-2 text-xs font-medium text-slate-500"><span class="h-2 w-2 rounded-full bg-emerald-500"></span>Completed</div>
            <div class="mt-2 text-3xl font-bold text-slate-900 tabular-nums"><%= stats.completed %></div>
            <div class="mt-2 h-1.5 rounded-full bg-slate-100 overflow-hidden"><div class="h-full bg-emerald-500" style="width: <%= stats.completionRate %>%"></div></div>
            <div class="mt-1 text-xs text-slate-400"><%= stats.completionRate %>% selesai</div>
        </a>
        <div class="bg-white rounded-xl ring-1 ring-slate-200 p-5">
            <div class="text-xs font-medium text-slate-500">Total PPN</div>
            <div class="mt-2 text-2xl font-bold text-slate-900 tabular-nums"><%= ui.rp(stats.totalPpn) %></div>
            <div class="mt-1 text-xs text-slate-400">Dari <%= ui.rp(stats.totalAmount) %></div>
        </div>
    </section>

    <section class="grid grid-cols-1 lg:grid-cols-3 gap-4">
        <!-- Bar chart -->
        <div class="lg:col-span-2 bg-white rounded-xl ring-1 ring-slate-200 p-5">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-semibold text-slate-900">Invoice per <%= stats.weekly ? 'minggu' : 'hari' %></h2>
                    <p class="text-xs text-slate-500">Berdasarkan tanggal XML terbit</p>
                </div>
                <div class="flex items-center gap-4 text-xs text-slate-500">
                    <span class="flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-sm bg-emerald-500"></span>Completed</span>
                    <span class="flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-sm bg-amber-400"></span>Pending</span>
                </div>
            </div>
            <%
                const labelEvery = stats.buckets.length > 20 ? 5 : (stats.buckets.length > 10 ? 2 : 1);
                const yMax = stats.maxBucket;
                const ticks = [yMax, Math.round(yMax / 2), 0].filter((v, i, a) => a.indexOf(v) === i);
            %>
            <div class="mt-5 flex gap-2">
                <div class="flex flex-col justify-between h-48 pb-5 text-[10px] text-slate-400 tabular-nums text-right w-5">
                    <% ticks.forEach(t => { %><span><%= t %></span><% }) %>
                </div>
                <div class="flex-1">
                    <div class="relative h-48 border-b border-slate-200">
                        <div class="absolute inset-x-0 top-0 border-t border-dashed border-slate-100"></div>
                        <div class="absolute inset-x-0 top-1/2 border-t border-dashed border-slate-100"></div>
                        <div class="absolute inset-0 flex items-end gap-[3px]">
                            <% stats.buckets.forEach(b => { const tot = b.pending + b.completed; %>
                                <div class="bar-col group relative flex-1 h-full flex flex-col justify-end">
                                    <div class="bar-tip pointer-events-none absolute -top-9 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-md bg-slate-900 px-2 py-1 text-[10px] text-white opacity-0 transition z-10">
                                        <%= b.label %>: <%= b.completed %> completed, <%= b.pending %> pending
                                    </div>
                                    <% if (tot) { %>
                                        <div class="w-full rounded-t-[3px] overflow-hidden flex flex-col-reverse" style="height: <%= (tot / yMax * 100).toFixed(1) %>%">
                                            <div class="bg-emerald-500 group-hover:bg-emerald-600" style="height: <%= (b.completed / tot * 100).toFixed(1) %>%"></div>
                                            <div class="bg-amber-400 group-hover:bg-amber-500" style="height: <%= (b.pending / tot * 100).toFixed(1) %>%"></div>
                                        </div>
                                    <% } else { %>
                                        <div class="w-full h-[2px] bg-slate-100 rounded"></div>
                                    <% } %>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                    <div class="flex gap-[3px] mt-1.5">
                        <% stats.buckets.forEach((b, i) => { %>
                            <div class="flex-1 text-center text-[10px] text-slate-400 truncate"><%= (i % labelEvery === 0 || i === stats.buckets.length - 1) ? b.label : '' %></div>
                        <% }) %>
                    </div>
                </div>
            </div>
            <% if (!stats.total) { %>
                <p class="mt-3 text-center text-xs text-slate-400">Belum ada invoice pada periode ini.</p>
            <% } %>
        </div>

        <!-- Butuh tindakan -->
        <div class="bg-white rounded-xl ring-1 ring-slate-200 flex flex-col">
            <div class="px-5 pt-5 pb-3 flex items-center justify-between">
                <h2 class="text-sm font-semibold text-slate-900">Butuh upload FP</h2>
                <a href="/pending" class="text-xs font-semibold text-indigo-600 hover:text-indigo-800">Lihat semua →</a>
            </div>
            <% if (!recentPending.length) { %>
                <div class="flex-1 flex items-center justify-center px-5 pb-8 text-center text-xs text-slate-400">Semua Faktur Pajak sudah lengkap 🎉</div>
            <% } else { %>
                <ul class="divide-y divide-slate-100 px-2 pb-2">
                    <% recentPending.forEach(l => { const f = l.faktur || {}; %>
                        <li class="flex items-center justify-between gap-3 px-3 py-2.5">
                            <div class="min-w-0">
                                <div class="font-mono text-xs font-semibold text-slate-800 truncate"><%= l.invoiceNumber %></div>
                                <div class="text-xs text-slate-500 truncate"><%= l.customerName %> · <%= l.date.slice(0, 10) %></div>
                            </div>
                            <button type="button" onclick="openFakturModal(this)" data-id="<%= l.id %>" data-invoice="<%= l.invoiceNumber %>"
                                data-number="<%= f.number || '' %>" data-date="<%= f.date || '' %>" data-status="<%= f.status || '' %>"
                                class="<%= ui.btnGhost %>">Upload FP</button>
                        </li>
                    <% }) %>
                </ul>
            <% } %>
        </div>
    </section>
</main>
</div>

<%- include('partials/modals') %>
</body>
</html>

# Salin menjadi .env lalu isi. Jangan commit file .env.
PORT=3000
PUBLIC_BASE_URL=https://efaktur.astakorpora.com

# String acak panjang (mis. `openssl rand -hex 32`)
SESSION_SECRET=
# Kunci enkripsi kredensial di database.json. JANGAN diganti setelah ada data,
# atau client secret / refresh token / password SMTP tersimpan tidak bisa dibaca lagi.
APP_SECRET=

# SMTP pusat (dipakai tenant yang tidak memakai SMTP kustom)
SMTP_HOST=mail.astabumi.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@astabumi.com
SMTP_PASS=

# Opsional: lokasi database.json & .app-secret (default: folder aplikasi)
# DATA_DIR=/var/lib/efaktur-gateway

# Port Docker di host. Default 127.0.0.1:3000 (di belakang Nginx).
# Untuk akses langsung via http://IP:3012 isi:
# HOST_BIND=0.0.0.0
# HOST_PORT=3012
